{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "files": { "ignoreUnknown": true },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 120 },
  "linter": { "rules": { "preset": "recommended", "suspicious": { "noExplicitAny": "error" } } },
  "javascript": { "formatter": { "semicolons": "asNeeded" } },
  "overrides": [
    {
      "includes": ["src/prompts.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noTemplateCurlyInString": "off"
          }
        }
      }
    }
  ]
}
